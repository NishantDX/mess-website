# Environment Variables
PORT=5000
MONGO_URI=your_mongodb_connection_string
BASE_URL=http://localhost:5000

# Optional: enable Redis caching for the menu endpoints.
# Leave unset to disable caching entirely (reads go straight to MongoDB).
# Local docker-compose sets this to redis://redis:6379 automatically.
REDIS_URL=

# Demo only: when "true", a daily cron generates synthetic attendance for the
# seeded SIM students (see SIMULATION.md). Off by default.
SIMULATE_ATTENDANCE=false

# Firebase configuration would go here
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_CLIENT_EMAIL=
